#!/bin/sh
# Signs a Windows executable in place with Nexpingdesk's self-signed Authenticode
# certificate. Uses a free RFC 3161 timestamp server so the
# signature stays valid after the certificate expires.
# Env: NEXPINGDESK_WIN_PFX (path), NEXPINGDESK_WIN_PFX_PASSWORD
set -eu
f="$1"
: "${NEXPINGDESK_WIN_PFX:?NEXPINGDESK_WIN_PFX not set}"
: "${NEXPINGDESK_WIN_PFX_PASSWORD:?NEXPINGDESK_WIN_PFX_PASSWORD not set}"
pw="$(mktemp)"; tmp="$f.signing"
trap 'rm -f "$pw" "$tmp"' EXIT
chmod 600 "$pw"
printf '%s' "$NEXPINGDESK_WIN_PFX_PASSWORD" > "$pw"
sign() {
  osslsigncode sign -pkcs12 "$NEXPINGDESK_WIN_PFX" -readpass "$pw" -n "Nexpingdesk" \
    -i "https://github.com" -h sha256 "$@" -in "$f" -out "$tmp" >/dev/null
}
for ts in http://timestamp.digicert.com http://timestamp.sectigo.com http://timestamp.acs.microsoft.com; do
  if sign -ts "$ts"; then mv "$tmp" "$f"; echo "signed $f"; exit 0; fi
done
echo "nd-sign-windows: no timestamp server reachable; signing without a timestamp" >&2
sign
mv "$tmp" "$f"
echo "signed $f (no timestamp)"
